<?xml version="1.0" encoding="utf-8"?>
<!--
  Uzume MSI (WiX v5): features Player (the app) and Hub (the server), scope perUserOrMachine. Contract: docs (installer section, 0.9).
  Build: packaging/windows/build-msi.ps1 (Windows only; pins WiX 5.0.2 and its extensions).
  Defines (wix build -d NAME=VALUE): ProductVersion (a.b.c[.d], numeric), PackageDir (assembled Player package),
  HubExe (uzume-server.exe), LicenseRtf (licence text, generated by build-msi.ps1), IconFile (uzume.ico), DialogBmp and BannerBmp
  (WixUIDialogBmp 493 x 312 and WixUIBannerBmp 493 x 58, packaging/windows/bitmaps, generated by scripts/make-icons.py),
  CompressionLevel (cab compression, default high; CI builds its test-only MSIs with none).

  Defaults (silent, no properties): Player only, per user, %LOCALAPPDATA%\Programs\Uzume. INSTALL_HUB=1 (or ADDLOCAL with Hub)
  switches to per machine: Player in %ProgramFiles%\Uzume\App, Hub in %ProgramFiles%\Uzume\Server, two services. Never touches the Player's data\.
  The app package carries bin\uzume-server.exe for "Only on this PC" (child process, no service, ADR 0030 D6).
  Dialogs follow docs/design/uzume/runs-and-server.md 8l (three options, destination, server options, finish, remove).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <?ifndef ProductVersion?><?error ProductVersion is not defined: pass -d ProductVersion=a.b.c.d?><?endif?>
  <?ifndef PackageDir?><?error PackageDir is not defined?><?endif?>
  <?ifndef HubExe?><?error HubExe is not defined?><?endif?>
  <?ifndef LicenseRtf?><?error LicenseRtf is not defined?><?endif?>
  <?ifndef CompressionLevel?><?define CompressionLevel = "high"?><?endif?>
  <?ifndef IconFile?><?define IconFile = "$(sys.SOURCEFILEDIR)..\..\client\app\icons\uzume.ico"?><?endif?>
  <?ifndef DialogBmp?><?define DialogBmp = "$(sys.SOURCEFILEDIR)bitmaps\dialog.bmp"?><?endif?>
  <?ifndef BannerBmp?><?define BannerBmp = "$(sys.SOURCEFILEDIR)bitmaps\banner.bmp"?><?endif?>

  <!-- The Player's AUMID. -->
  <?define AppUserModelId = "Uzume.App"?>

  <Package Name="Uzume" Manufacturer="Uzume" Version="$(ProductVersion)"
           UpgradeCode="3B9D7A52-6C14-4E8F-A2D5-71F0C8E94B36" Scope="perUserOrMachine"
           Language="1033" InstallerVersion="500" Compressed="yes">

    <!-- afterInstallInitialize: RemoveExistingProducts (and the deferred removal actions below) must sit between InstallInitialize and
         InstallFinalize (ICE77); the default schedule would put it before InstallInitialize. -->
    <!-- AllowDowngrades: "Go back to <version>" (update rollback, ADR 0029 D4) installs this MSI over a newer one and keeps
         the data (settings, saves). An MSI authored without it refuses to install over a newer version, so the signed
         index marks the releases built with it (msi_downgrade) and only those are offered as rollback targets.
         It also covers reinstalling the same version, so WiX forbids AllowSameVersionUpgrades next to it. -->
    <MajorUpgrade AllowDowngrades="yes" Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="$(CompressionLevel)" />
    <Icon Id="PlayerIcon" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="PlayerIcon" />
    <WixVariable Id="WixUILicenseRtf" Value="$(LicenseRtf)" />
    <!-- Installer bitmaps (docs/design/uzume/runs-and-server.md 8l-0): Welcome/Finish and the banner of every other page. -->
    <WixVariable Id="WixUIDialogBmp" Value="$(DialogBmp)" />
    <WixVariable Id="WixUIBannerBmp" Value="$(BannerBmp)" />

    <!-- ===== Public properties (Secure: they must reach the elevated server when a per-user UI elevates) ===== -->
    <!-- Unset = default: install the Player (only INSTALL_PLAYER="0" removes it). Unset on purpose, see SetInstallPlayerOffOnUpgrade. -->
    <Property Id="INSTALL_PLAYER" Secure="yes" />
    <Property Id="INSTALL_HUB" Secure="yes" />
    <!-- Not given: the port of the installed Hub (upgrade), else 8443 (see SetHubPortDefault). -->
    <Property Id="HUB_PORT" Secure="yes" />
    <Property Id="HUB_PORT_DEFAULT" Value="8443">
      <RegistrySearch Id="HubPortInstalled" Root="HKLM" Key="Software\Uzume\Server" Name="PortText" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="HUB_SHARING_OLD">
      <RegistrySearch Id="HubSharingInstalled" Root="HKLM" Key="Software\Uzume\Server" Name="SharingFlag" Type="raw" Bitness="always64" />
    </Property>
    <!-- Unset on the command line: 1 for Hub only, 0 for Player and Hub (see SetNetworkSharingDefault). -->
    <Property Id="NETWORK_SHARING" Secure="yes" />
    <Property Id="DESKTOP_SHORTCUT" Secure="yes" />
    <Property Id="INSTALL_CHOICE" Value="PLAYER" Secure="yes" />
    <Property Id="HUB_SHARING_FLAG" Value="false" />
    <!-- "Share with others" (ADR 0030 D6): the app runs this MSI with INSTALL_HUB=1 and the folder of its per-user server; the
         server imports it into the service's data folder before the service starts (see ImportServerData). -->
    <Property Id="IMPORT_SERVER_DATA" Secure="yes" />
    <!-- Remove dialog (8L-9) or `msiexec /x ... REMOVE_SERVER_DATA=1`: also delete %ProgramData%\Uzume\Server and ServerUpdater. -->
    <Property Id="REMOVE_SERVER_DATA" Secure="yes" />
    <!-- No "Change" in Apps & features or the maintenance dialog: the scope (per user or per machine) of an installed product
         cannot change, so switching between the three options is remove and install again (8L-8). -->
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- ===== Scope and defaults ===== -->
    <!-- INSTALL_HUB=1 / ADDLOCAL with Hub means per machine (ALLUSERS=1, MSIINSTALLPERUSER cleared); the elevation comes
         from the caller (silent) or from the UAC prompt of a limited-privilege package (UI). -->
    <SetProperty Id="ALLUSERS" Value="1" Before="LaunchConditions" Sequence="both"
                 Condition="INSTALL_HUB=&quot;1&quot; OR ADDLOCAL ~&gt;&lt; &quot;Hub&quot;" />
    <SetProperty Id="MSIINSTALLPERUSER" Value="{}" After="SetALLUSERS" Sequence="both"
                 Condition="INSTALL_HUB=&quot;1&quot; OR ADDLOCAL ~&gt;&lt; &quot;Hub&quot;" />
    <SetProperty Id="HUB_PORT" Action="SetHubPortDefault" Value="[HUB_PORT_DEFAULT]" Before="LaunchConditions" Sequence="both"
                 Condition="HUB_PORT=&quot;&quot;" />
    <!-- Upgrades (e.g. by the Hub updater, which passes only ALLUSERS=1) keep the installed feature set (MigrateFeatureStates
         wins: the feature Levels below only apply to fresh installs), the port and the sharing choice of the installed Hub. -->
    <SetProperty Id="NETWORK_SHARING" Action="SetSharingFromInstalledOn" Value="1" Before="SetNETWORK_SHARING" Sequence="execute"
                 Condition="NETWORK_SHARING=&quot;&quot; AND HUB_SHARING_OLD=&quot;true&quot;" />
    <SetProperty Id="NETWORK_SHARING" Action="SetSharingFromInstalledOff" Value="0" Before="SetNETWORK_SHARING" Sequence="execute"
                 Condition="NETWORK_SHARING=&quot;&quot; AND HUB_SHARING_OLD=&quot;false&quot;" />
    <!-- Upgrading a Hub-only install (e.g. by the Hub updater, which passes only ALLUSERS=1): MigrateFeatureStates does not keep an
         absent feature absent, so the Player would appear. Detect the installed product by its files (works for any earlier build):
         Hub marker present, Player marker absent, nothing given explicitly -> INSTALL_PLAYER=0. A per-user or Player(+Hub) upgrade
         is not affected (no Hub marker, or a Player marker). -->
    <Property Id="OLD_HUB_MARKER">
      <DirectorySearch Id="OldHubDir" Path="[ProgramFiles64Folder]Uzume\Server" Depth="0">
        <FileSearch Id="OldHubMarker" Name="uzume-server.msi-installed" />
      </DirectorySearch>
    </Property>
    <Property Id="OLD_PLAYER_MARKER">
      <DirectorySearch Id="OldPlayerDir" Path="[ProgramFiles64Folder]Uzume\App" Depth="0">
        <FileSearch Id="OldPlayerMarker" Name="uzume-app.msi-installed" />
      </DirectorySearch>
    </Property>
    <SetProperty Id="INSTALL_PLAYER" Action="SetInstallPlayerOffOnUpgrade" Value="0" Before="SetSharingFromInstalledOn" Sequence="execute"
                 Condition="WIX_UPGRADE_DETECTED AND INSTALL_PLAYER=&quot;&quot; AND NOT ADDLOCAL AND OLD_HUB_MARKER AND NOT OLD_PLAYER_MARKER" />
    <!-- Network sharing default when not given: Hub only = on; Player and Hub = off (unset counts as off; the Player runs on the same PC). -->
    <SetProperty Id="NETWORK_SHARING" Value="1" Before="CostInitialize" Sequence="execute"
                 Condition="NETWORK_SHARING=&quot;&quot; AND INSTALL_PLAYER=&quot;0&quot;" />
    <SetProperty Id="HUB_SHARING_FLAG" Value="true" Before="CostFinalize" Sequence="execute"
                 Condition="NETWORK_SHARING=&quot;1&quot;" />
    <!-- The per-user folder is the static default of PLAYERDIR (%LOCALAPPDATA%\Programs\Uzume)
         so the documented default needs no custom action. Only the per-machine install redirects it to
         %ProgramFiles%\Uzume\App (trailing backslash: directory properties end with one). -->
    <SetDirectory Id="PLAYERDIR" Value="[ProgramFiles64Folder]Uzume\App\" Sequence="execute" Condition="ALLUSERS=1" />

    <Launch Condition="Installed OR (HUB_PORT &gt;= 1 AND HUB_PORT &lt;= 65535)"
            Message="HUB_PORT must be a TCP port number between 1 and 65535." />
    <Launch Condition="Installed OR INSTALL_HUB&lt;&gt;&quot;1&quot; OR ALLUSERS=1"
            Message="The Uzume server can only be installed for all users. Run the installer as administrator." />

    <!-- ===== Detection of an earlier per-user install ===== -->
    <!-- A per-user MSI install of this product (written by PlayerUserRegistry below). -->
    <Property Id="PERUSER_PRODUCTCODE">
      <RegistrySearch Id="PerUserProductCode" Root="HKCU" Key="Software\Uzume\App" Name="ProductCode" Type="raw" Bitness="always64" />
    </Property>

    <!-- Per-user MSI product (installing per machine): `msiexec /x <code> /qn`, impersonated. A nested msiexec started while this
         installation holds the _MSIExecute mutex fails with 1618, so the removal is a detached process (asyncNoWait, result not
         checked) that RETRIES until Windows Installer is free: a fixed delay is not enough, copying the Player takes longer
         than any short wait (the first version, `ping -n 15`, ran into 1618 and left the product behind). Exit 0/3010 = removed,
         1605/1614 = already gone, 1618 (and anything else) = try again, 60 attempts 5 s apart. Logs for diagnosis:
         %ProgramData%\Uzume-remove-per-user.log (msiexec /l*v) and ...status.txt (one line per attempt). -->
    <CustomAction Id="RemovePerUserProduct" Directory="TempFolder" Execute="deferred" Impersonate="yes" Return="asyncNoWait"
                  ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -Command &quot;$c='[PERUSER_PRODUCTCODE]'; $l=Join-Path $env:ProgramData 'Uzume-remove-per-user.log'; $t=$l+'.status.txt'; for($i=1;$i -le 60;$i++){ Start-Sleep 5; $p=Start-Process msiexec.exe -ArgumentList @('/x',$c,'/qn','/norestart','/l*v',$l) -Wait -PassThru; Add-Content $t ('attempt '+$i+' exit '+$p.ExitCode); if(@(0,3010,1605,1614) -contains $p.ExitCode){break} }&quot;" />

    <InstallExecuteSequence>
      <!-- Only per machine, and never for our own product code (an upgrade of the per-user install by itself). -->
      <Custom Action="RemovePerUserProduct" Before="InstallFiles"
              Condition="NOT Installed AND ALLUSERS=1 AND PERUSER_PRODUCTCODE AND PERUSER_PRODUCTCODE&lt;&gt;ProductCode" />
    </InstallExecuteSequence>

    <!-- A running Player is asked to close (WM_CLOSE) before files are replaced; the launcher and the real Player have the
         same image name. If it stays open, Windows Installer's file-in-use handling takes over (dialog in the UI). -->
    <util:CloseApplication Id="ClosePlayerUzume" Target="Uzume.exe" CloseMessage="yes" RebootPrompt="no" />

    <!-- ===== Features ===== -->
    <Feature Id="Player" Title="Uzume" Level="1" AllowAdvertise="no">
      <Level Value="0" Condition="INSTALL_PLAYER=&quot;0&quot;" />
      <ComponentGroupRef Id="PlayerFiles" />
      <ComponentRef Id="PlayerMarker" />
      <ComponentRef Id="PlayerShell" />
      <ComponentRef Id="PlayerUserRegistry" />
      <ComponentRef Id="PlayerDesktopShortcut" />
    </Feature>
    <Feature Id="Hub" Title="Uzume server" Level="2" AllowAdvertise="no">
      <Level Value="1" Condition="INSTALL_HUB=&quot;1&quot;" />
      <ComponentRef Id="HubProgram" />
      <ComponentRef Id="HubMarker" />
      <ComponentRef Id="HubRegistry" />
      <ComponentRef Id="HubDataFolders" />
    </Feature>

    <!-- ===== UI: welcome, licence, what to install, Hub options, ready, progress, finish ===== -->
    <UIRef Id="UzumeUI" />
  </Package>

  <!-- ===== Directories ===== -->
  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="UZUMEDIR" Name="Uzume">
        <Directory Id="HUBDIR" Name="Server" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="USERPROGRAMSDIR" Name="Programs">
        <Directory Id="PLAYERDIR" Name="Uzume" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="PDUZUME" Name="Uzume">
        <Directory Id="PDHUB" Name="Server">
          <Directory Id="PDHUBREQUEST" Name="update-request" />
        </Directory>
        <Directory Id="PDHUBUPDATER" Name="ServerUpdater" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

  <!-- ===== Player ===== -->
  <Fragment>
    <!-- The assembled package: launcher Uzume.exe, THIRD-PARTY-NOTICE.txt, LICENSE.txt, licenses\ at the top,
         the real app (bin\Uzume.exe), Qt/vcpkg DLLs, plugins and qml in bin\. data\ is never part of the MSI (ADR 0004). -->
    <ComponentGroup Id="PlayerFiles" Directory="PLAYERDIR">
      <!-- No Exclude for data\: with a missing excluded directory WiX drops ALL files of the harvest (WIX8601, zero files).
           build-msi.ps1 guarantees that the package has no data\ and counts the harvested files after the build. -->
      <Files Include="$(PackageDir)\**" />
    </ComponentGroup>

    <!-- Start menu shortcut (with the AUMID the executables use), install marker and folder of the install. -->
    <Component Id="PlayerMarker" Directory="PLAYERDIR" Guid="*">
      <File Id="PlayerMarkerFile" Name="uzume-app.msi-installed" Source="$(sys.SOURCEFILEDIR)msi-marker.txt" KeyPath="yes" />
    </Component>
    <Component Id="PlayerShell" Directory="PLAYERDIR" Guid="*">
      <Shortcut Id="PlayerStartMenu" Directory="ProgramMenuFolder" Name="Uzume"
                Target="[PLAYERDIR]Uzume.exe" WorkingDirectory="PLAYERDIR" Icon="PlayerIcon">
        <ShortcutProperty Key="System.AppUserModel.ID" Value="$(AppUserModelId)" />
      </Shortcut>
      <RegistryValue Root="HKMU" Key="Software\Uzume\App" Name="InstallDir" Type="string" Value="[PLAYERDIR]" KeyPath="yes" />
    </Component>

    <!-- Per-user installs record their product code: a later per-machine install removes this product (see above). -->
    <Component Id="PlayerUserRegistry" Directory="PLAYERDIR" Guid="*" Condition="NOT ALLUSERS=1">
      <RegistryValue Root="HKCU" Key="Software\Uzume\App" Name="ProductCode" Type="string" Value="[ProductCode]" KeyPath="yes" />
    </Component>

    <Component Id="PlayerDesktopShortcut" Directory="DesktopFolder" Guid="*" Condition="DESKTOP_SHORTCUT=&quot;1&quot;">
      <Shortcut Id="PlayerDesktop" Name="Uzume" Target="[PLAYERDIR]Uzume.exe"
                WorkingDirectory="PLAYERDIR" Icon="PlayerIcon">
        <ShortcutProperty Key="System.AppUserModel.ID" Value="$(AppUserModelId)" />
      </Shortcut>
      <RegistryValue Root="HKMU" Key="Software\Uzume\App" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- ===== Hub (per machine only) ===== -->
  <Fragment>
    <Component Id="HubProgram" Directory="HUBDIR" Guid="*">
      <File Id="HubExe" Name="uzume-server.exe" Source="$(HubExe)" KeyPath="yes" />

      <!-- Virtual service account NT SERVICE\UzumeServer; its folder rights are granted in GrantHubFolders. -->
      <ServiceInstall Id="HubService" Name="UzumeServer" DisplayName="Uzume server"
                      Description="Uzume server: central ROM library, saves and sessions."
                      Type="ownProcess" Start="auto" ErrorControl="normal" Vital="yes"
                      Account="NT SERVICE\UzumeServer"
                      Arguments="-listen :[HUB_PORT] -network-sharing=[HUB_SHARING_FLAG]">
        <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart" ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="5" ResetPeriodInDays="1" />
      </ServiceInstall>
      <ServiceControl Id="HubServiceControl" Name="UzumeServer" Start="install" Stop="both" Remove="uninstall" Wait="yes" />

      <ServiceInstall Id="HubUpdaterService" Name="UzumeServerUpdater" DisplayName="Uzume server updater"
                      Description="Applies Uzume server updates requested from the server web UI."
                      Type="ownProcess" Start="auto" ErrorControl="normal" Vital="yes"
                      Arguments="update watch">
        <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart" ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="5" ResetPeriodInDays="1" />
      </ServiceInstall>
      <ServiceControl Id="HubUpdaterServiceControl" Name="UzumeServerUpdater" Start="install" Stop="both" Remove="uninstall" Wait="yes" />

      <!-- Program based, so the Hub port and the TURN relay ports (-turn-port/-turn-relay-ports) are covered. The Hub binds
           only loopback while network sharing is off, which the rules do not change. -->
      <fw:FirewallException Id="HubFirewallTcp" Name="Uzume server (TCP)" File="HubExe" Protocol="tcp" Scope="any" Profile="all" IgnoreFailure="yes" />
      <fw:FirewallException Id="HubFirewallUdp" Name="Uzume server (UDP, TURN)" File="HubExe" Protocol="udp" Scope="any" Profile="all" IgnoreFailure="yes" />
    </Component>

    <Component Id="HubMarker" Directory="HUBDIR" Guid="*">
      <File Id="HubMarkerFile" Name="uzume-server.msi-installed" Source="$(sys.SOURCEFILEDIR)msi-marker.txt" KeyPath="yes" />
    </Component>

    <!-- The Player finds the local Hub here. -->
    <Component Id="HubRegistry" Directory="HUBDIR" Guid="*">
      <RegistryValue Root="HKLM" Key="Software\Uzume\Server" Name="Port" Type="integer" Value="[HUB_PORT]" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="Software\Uzume\Server" Name="InstallDir" Type="string" Value="[HUBDIR]" />
      <!-- Text copies for the next upgrade's RegistrySearch (a DWORD would come back as "#18443"). -->
      <RegistryValue Root="HKLM" Key="Software\Uzume\Server" Name="PortText" Type="string" Value="[HUB_PORT]" />
      <RegistryValue Root="HKLM" Key="Software\Uzume\Server" Name="SharingFlag" Type="string" Value="[HUB_SHARING_FLAG]" />
    </Component>

    <!-- Data folders are created empty and left behind on uninstall when they hold data. -->
    <Component Id="HubDataFolders" Directory="PDHUB" Guid="*">
      <CreateFolder />
      <CreateFolder Directory="PDHUBREQUEST" />
      <CreateFolder Directory="PDHUBUPDATER" />
      <RegistryValue Root="HKLM" Key="Software\Uzume\Server" Name="DataFolders" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- ACLs (icacls: the service SID NT SERVICE\UzumeServer only resolves once InstallServices has created the service,
         which is why PermissionEx is not used). After InstallServices, before StartServices:
           Hub data: SYSTEM + Administrators full, NT SERVICE\UzumeServer modify (update-request\ inherits it).
           HubUpdater: SYSTEM + Administrators only. -->
    <CustomAction Id="GrantHubFolders" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="GrantHubUpdaterFolder" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="check" />
    <SetProperty Id="GrantHubFolders" Before="GrantHubFolders" Sequence="execute"
                 Value="&quot;[System64Folder]icacls.exe&quot; &quot;[CommonAppDataFolder]Uzume\Server&quot; /inheritance:r /grant:r *S-1-5-18:(OI)(CI)F *S-1-5-32-544:(OI)(CI)F &quot;NT SERVICE\UzumeServer:(OI)(CI)M&quot;"
                 Condition="&amp;Hub=3" />
    <SetProperty Id="GrantHubUpdaterFolder" Before="GrantHubUpdaterFolder" Sequence="execute"
                 Value="&quot;[System64Folder]icacls.exe&quot; &quot;[CommonAppDataFolder]Uzume\ServerUpdater&quot; /inheritance:r /grant:r *S-1-5-18:(OI)(CI)F *S-1-5-32-544:(OI)(CI)F"
                 Condition="&amp;Hub=3" />
    <!-- "Share with others": import the app's per-user server data into the service's data folder (uzume-server import-data
         refuses to overwrite an existing server database). After the ACLs, so the copied files inherit them; before
         StartServices. A non-zero exit fails the installation and rolls it back. -->
    <CustomAction Id="ImportServerData" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="check" />
    <SetProperty Id="ImportServerData" Before="ImportServerData" Sequence="execute"
                 Value="&quot;[HUBDIR]uzume-server.exe&quot; import-data --from &quot;[IMPORT_SERVER_DATA]&quot;"
                 Condition="&amp;Hub=3 AND IMPORT_SERVER_DATA" />

    <!-- Remove with "Also delete all server data" (8L-9): the data and updater folders in ProgramData, after the services and
         files are gone. Never on an upgrade. -->
    <CustomAction Id="DeleteServerData" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="ignore" />
    <SetProperty Id="DeleteServerData" Before="DeleteServerData" Sequence="execute"
                 Value="&quot;[System64Folder]cmd.exe&quot; /c rmdir /s /q &quot;[CommonAppDataFolder]Uzume\Server&quot; &amp; rmdir /s /q &quot;[CommonAppDataFolder]Uzume\ServerUpdater&quot;"
                 Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND REMOVE_SERVER_DATA=&quot;1&quot;" />

    <InstallExecuteSequence>
      <Custom Action="GrantHubFolders" After="InstallServices" Condition="&amp;Hub=3" />
      <Custom Action="GrantHubUpdaterFolder" After="GrantHubFolders" Condition="&amp;Hub=3" />
      <Custom Action="ImportServerData" After="GrantHubUpdaterFolder" Condition="&amp;Hub=3 AND IMPORT_SERVER_DATA" />
      <Custom Action="DeleteServerData" After="RemoveFolders"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND REMOVE_SERVER_DATA=&quot;1&quot;" />
    </InstallExecuteSequence>
  </Fragment>

  <!-- ===== UI ===== -->
  <Fragment>
    <UI Id="UzumeUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="WixUI_Mode" Value="Mondo" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />
      <DialogRef Id="LicenseAgreementDlg" />
      <DialogRef Id="VerifyReadyDlg" />
      <DialogRef Id="MaintenanceWelcomeDlg" />
      <DialogRef Id="MaintenanceTypeDlg" />
      <DialogRef Id="ExitDialog" />
      <DialogRef Id="CancelDlg" />
      <UIRef Id="WixUI_Common" />

      <!-- 8L-2 How will you use Uzume? The app only = per user without administrator rights; with the server = per machine
           (UAC prompt). The radio values stay PLAYER / BOTH / HUB. -->
      <Dialog Id="ChoiceDlg" Width="370" Height="270" Title="!(loc.WelcomeDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}How will you use Uzume?" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="270" Height="15" Transparent="yes" NoPrefix="yes" Text="One installer sets up the app, a server or both." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Choice" Type="RadioButtonGroup" X="20" Y="58" Width="330" Height="160" Property="INSTALL_CHOICE">
          <RadioButtonGroup Property="INSTALL_CHOICE">
            <RadioButton Value="PLAYER" X="0" Y="0" Width="330" Height="40"
                         Text="&amp;Uzume: for you only, no administrator rights. Play on a server of friends or only on this PC." />
            <RadioButton Value="BOTH" X="0" Y="56" Width="330" Height="40"
                         Text="Uzume &amp;with a server on this PC: needs administrator rights and installs for all users. You set up the server in Uzume." />
            <RadioButton Value="HUB" X="0" Y="112" Width="330" Height="40"
                         Text="&amp;Only the server: needs administrator rights. The last page shows how to set it up from another PC." />
          </RadioButtonGroup>
        </Control>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="LicenseAgreementDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Property="INSTALL_PLAYER" Value="0" Condition="INSTALL_CHOICE=&quot;HUB&quot;" Order="1" />
          <Publish Property="INSTALL_PLAYER" Value="1" Condition="INSTALL_CHOICE&lt;&gt;&quot;HUB&quot;" Order="2" />
          <Publish Property="INSTALL_HUB" Value="1" Condition="INSTALL_CHOICE&lt;&gt;&quot;PLAYER&quot;" Order="3" />
          <Publish Property="INSTALL_HUB" Value="{}" Condition="INSTALL_CHOICE=&quot;PLAYER&quot;" Order="4" />
          <Publish Property="NETWORK_SHARING" Value="1" Condition="INSTALL_CHOICE=&quot;HUB&quot;" Order="5" />
          <Publish Property="NETWORK_SHARING" Value="0" Condition="INSTALL_CHOICE&lt;&gt;&quot;HUB&quot;" Order="6" />
          <Publish Property="ALLUSERS" Value="1" Condition="INSTALL_CHOICE&lt;&gt;&quot;PLAYER&quot;" Order="7" />
          <Publish Property="MSIINSTALLPERUSER" Value="{}" Condition="INSTALL_CHOICE&lt;&gt;&quot;PLAYER&quot;" Order="8" />
          <Publish Property="ALLUSERS" Value="2" Condition="INSTALL_CHOICE=&quot;PLAYER&quot;" Order="9" />
          <Publish Property="MSIINSTALLPERUSER" Value="1" Condition="INSTALL_CHOICE=&quot;PLAYER&quot;" Order="10" />
          <Publish Property="DESKTOP_SHORTCUT" Value="{}" Condition="INSTALL_CHOICE=&quot;HUB&quot;" Order="11" />
          <!-- Finish page (8L-6 / 8L-7): the optional checkbox and text of the stock ExitDialog. -->
          <Publish Property="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" Order="12" />
          <Publish Property="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Start Uzume" Condition="INSTALL_CHOICE&lt;&gt;&quot;HUB&quot;" Order="13" />
          <Publish Property="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Show the address, security code and setup code (Windows asks for administrator rights)" Condition="INSTALL_CHOICE=&quot;HUB&quot;" Order="14" />
          <Publish Property="WIXUI_EXITDIALOGOPTIONALTEXT" Value="{}" Condition="INSTALL_CHOICE=&quot;PLAYER&quot;" Order="15" />
          <Publish Property="WIXUI_EXITDIALOGOPTIONALTEXT" Value="The Uzume server runs as a Windows service. Start Uzume to set it up: you become its admin." Condition="INSTALL_CHOICE=&quot;BOTH&quot;" Order="16" />
          <Publish Property="WIXUI_EXITDIALOGOPTIONALTEXT" Value="The Uzume server is running. Set it up from Uzume on another PC: Set up a server &gt; On another device, with the setup code. A new code later: uzume-server setup-code in a terminal as administrator." Condition="INSTALL_CHOICE=&quot;HUB&quot;" Order="17" />
          <Publish Property="WixShellExecTarget" Value="[LocalAppDataFolder]Programs\Uzume\Uzume.exe" Condition="INSTALL_CHOICE=&quot;PLAYER&quot;" Order="18" />
          <Publish Property="WixShellExecTarget" Value="[ProgramFiles64Folder]Uzume\App\Uzume.exe" Condition="INSTALL_CHOICE=&quot;BOTH&quot;" Order="19" />
          <Publish Event="NewDialog" Value="FolderDlg" Order="20" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- 8L-3 Destination folder: fixed by the choice (per user or all users), shown, not editable. -->
      <Dialog Id="FolderDlg" Width="370" Height="270" Title="!(loc.WelcomeDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Destination folder" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="270" Height="15" Transparent="yes" NoPrefix="yes" Text="Uzume is installed in this folder." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="UserFolder" Type="Text" X="20" Y="60" Width="330" Height="16" NoPrefix="yes" Text="[LocalAppDataFolder]Programs\Uzume\"
                 HideCondition="INSTALL_CHOICE&lt;&gt;&quot;PLAYER&quot;" ShowCondition="INSTALL_CHOICE=&quot;PLAYER&quot;" />
        <Control Id="MachineFolder" Type="Text" X="20" Y="60" Width="330" Height="16" NoPrefix="yes" Text="[ProgramFiles64Folder]Uzume\"
                 HideCondition="INSTALL_CHOICE=&quot;PLAYER&quot;" ShowCondition="INSTALL_CHOICE&lt;&gt;&quot;PLAYER&quot;" />
        <Control Id="UserHelp" Type="Text" X="20" Y="82" Width="330" Height="30" Transparent="yes" NoPrefix="yes"
                 Text="For your account only. Settings, saves and the game cache are kept when you remove Uzume."
                 HideCondition="INSTALL_CHOICE&lt;&gt;&quot;PLAYER&quot;" ShowCondition="INSTALL_CHOICE=&quot;PLAYER&quot;" />
        <Control Id="MachineHelp" Type="Text" X="20" Y="82" Width="330" Height="40" Transparent="yes" NoPrefix="yes"
                 Text="For all users: the app in App, the server in Server. Server data (library, saves, accounts) goes to [CommonAppDataFolder]Uzume\Server and is kept when you remove Uzume."
                 HideCondition="INSTALL_CHOICE=&quot;PLAYER&quot;" ShowCondition="INSTALL_CHOICE&lt;&gt;&quot;PLAYER&quot;" />
        <Control Id="DesktopShortcut" Type="CheckBox" X="20" Y="140" Width="330" Height="18" Property="DESKTOP_SHORTCUT" CheckBoxValue="1" Text="Create a &amp;desktop shortcut for Uzume"
                 HideCondition="INSTALL_CHOICE=&quot;HUB&quot;" ShowCondition="INSTALL_CHOICE&lt;&gt;&quot;HUB&quot;" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="ChoiceDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="HubOptionsDlg" Condition="INSTALL_CHOICE&lt;&gt;&quot;PLAYER&quot;" Order="1" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Condition="INSTALL_CHOICE=&quot;PLAYER&quot;" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- 8L-4 Server options: port and sharing in the home network. -->
      <Dialog Id="HubOptionsDlg" Width="370" Height="270" Title="!(loc.WelcomeDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Server options" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="270" Height="15" Transparent="yes" NoPrefix="yes" Text="The server runs as the Windows service UzumeServer." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="PortLabel" Type="Text" X="20" Y="62" Width="150" Height="16" Transparent="yes" NoPrefix="yes" Text="Server &amp;port (HTTPS):" />
        <Control Id="Port" Type="Edit" X="175" Y="59" Width="60" Height="18" Property="HUB_PORT" Sunken="yes" Text="{5}" />
        <Control Id="Sharing" Type="CheckBox" X="20" Y="95" Width="330" Height="18" Property="NETWORK_SHARING" CheckBoxValue="1" Text="&amp;Share in your home network" />
        <Control Id="SharingHelp" Type="Text" X="38" Y="115" Width="312" Height="40" Transparent="yes" NoPrefix="yes"
                 Text="Off: only this PC can reach the server. On: other PCs in your network can join; the Windows firewall rules for the server apply." />
        <Control Id="InternetHelp" Type="Text" X="20" Y="165" Width="330" Height="30" Transparent="yes" NoPrefix="yes"
                 Text="Sharing over the internet is set up later in Uzume: Settings &gt; Server &gt; Network &amp; sharing." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="FolderDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <!-- An unchecked box leaves the property empty, which the silent default would read as "not given". -->
          <Publish Property="NETWORK_SHARING" Value="0" Condition="NETWORK_SHARING=&quot;&quot;" Order="1" />
          <!-- The UI copy of the service flag, for the setup code window on the finish page (the execute sequence sets its own). -->
          <Publish Property="HUB_SHARING_FLAG" Value="true" Condition="NETWORK_SHARING=&quot;1&quot;" Order="2" />
          <Publish Property="HUB_SHARING_FLAG" Value="false" Condition="NETWORK_SHARING&lt;&gt;&quot;1&quot;" Order="3" />
          <Publish Event="SpawnDialog" Value="InvalidPortDlg" Condition="NOT (HUB_PORT &gt;= 1 AND HUB_PORT &lt;= 65535)" Order="4" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Condition="HUB_PORT &gt;= 1 AND HUB_PORT &lt;= 65535" Order="5" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <Dialog Id="InvalidPortDlg" Width="260" Height="85" Title="[ProductName]">
        <Control Id="Text" Type="Text" X="48" Y="15" Width="194" Height="30" Text="The port must be a number between 1 and 65535." />
        <Control Id="Icon" Type="Icon" X="15" Y="15" Width="24" Height="24" ToolTip="Information" FixedSize="yes" IconSize="32" Text="WixUI_Ico_Info" />
        <Control Id="OK" Type="PushButton" X="102" Y="57" Width="56" Height="17" Default="yes" Cancel="yes" Text="!(loc.WixUIOK)">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <!-- 8L-9 Remove: data stays unless the box is ticked. Only shown when the server is installed. -->
      <Dialog Id="RemoveDataDlg" Width="370" Height="270" Title="!(loc.WelcomeDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Remove Uzume" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="270" Height="15" Transparent="yes" NoPrefix="yes" Text="The programs and the services are removed." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Keep" Type="Text" X="20" Y="60" Width="330" Height="30" Transparent="yes" NoPrefix="yes"
                 Text="Your saves, games and server data in [CommonAppDataFolder]Uzume stay, so a new install picks them up again." />
        <Control Id="DeleteData" Type="CheckBox" X="20" Y="100" Width="330" Height="18" Property="REMOVE_SERVER_DATA" CheckBoxValue="1" Text="Also &amp;delete all server data" />
        <Control Id="DeleteHelp" Type="Text" X="38" Y="120" Width="312" Height="40" Transparent="yes" NoPrefix="yes"
                 Text="Deletes the library, the saves of all users, accounts, plugins and backups in [CommonAppDataFolder]Uzume\Server. This cannot be undone." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Property="REMOVE_SERVER_DATA" Value="{}" Order="1" />
          <Publish Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- Flow -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="2" Condition="Installed AND PATCH" />
      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="1" />
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="ChoiceDlg" Order="2" Condition="LicenseAccepted = 1" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="HubOptionsDlg" Order="1" Condition="NOT Installed AND INSTALL_HUB=&quot;1&quot;" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="FolderDlg" Order="2" Condition="NOT Installed AND INSTALL_HUB&lt;&gt;&quot;1&quot;" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="RemoveDataDlg" Order="3" Condition="Installed AND NOT PATCH AND WixUI_InstallMode=&quot;Remove&quot; AND !Hub=3" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="4" Condition="Installed AND NOT PATCH AND NOT (WixUI_InstallMode=&quot;Remove&quot; AND !Hub=3)" />
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" Order="2" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="RemoveDataDlg" Order="2" Condition="!Hub=3" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" Order="3" Condition="NOT (!Hub=3)" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" Order="2" />
      <!-- Finish: start the app (8L-6), or show the setup code of a server-only install (8L-7, 8h-3) in an elevated window
           (the server data folder is for administrators only). -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApp" Order="997"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX=1 AND NOT Installed AND INSTALL_CHOICE&lt;&gt;&quot;HUB&quot;" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="ShowSetupCode" Order="998"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX=1 AND NOT Installed AND INSTALL_CHOICE=&quot;HUB&quot;" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
    </UI>

    <CustomAction Id="LaunchApp" BinaryRef="Wix4UtilCA_X64" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
    <!-- Start-Process -Verb RunAs: one UAC prompt, then a PowerShell window that stays open with `uzume-server setup-code`
         (address, security code, setup code; the same flags as the service so the addresses match). The code never
         touches a file or the MSI log. -->
    <CustomAction Id="ShowSetupCode" Directory="TempFolder" Return="asyncNoWait" Impersonate="yes"
                  ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -WindowStyle Hidden -Command &quot;Start-Process powershell.exe -Verb RunAs -ArgumentList '-NoProfile','-NoExit','-Command','&amp; ''[HUBDIR]uzume-server.exe'' setup-code -listen :[HUB_PORT] -network-sharing=[HUB_SHARING_FLAG]'&quot;" />
  </Fragment>
</Wix>
