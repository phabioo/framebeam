<?xml version="1.0" encoding="utf-8"?>
<!--
  FrameBeam MSI (WiX v5): features Player and Hub, scope perUserOrMachine. Contract: docs (installer section, 0.9).
  Build: packaging/windows/build-msi.ps1 (Windows only; pins WiX 5.0.2 and its extensions).
  Defines (wix build -d NAME=VALUE): ProductVersion (a.b.c[.d], numeric), PackageDir (assembled Player package),
  HubExe (framebeam-hub.exe), LicenseRtf (licence text, generated by build-msi.ps1), IconFile (player.ico).

  Defaults (silent, no properties): Player only, per user, %LOCALAPPDATA%\Programs\FrameBeam Player (same folder as the
  former Inno installer). INSTALL_HUB=1 (or ADDLOCAL with Hub) switches to per machine: Player in
  %ProgramFiles%\FrameBeam\Player, Hub in %ProgramFiles%\FrameBeam\Hub, two services. Never touches the Player's data\.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <?ifndef ProductVersion?><?error ProductVersion is not defined: pass -d ProductVersion=a.b.c.d?><?endif?>
  <?ifndef PackageDir?><?error PackageDir is not defined?><?endif?>
  <?ifndef HubExe?><?error HubExe is not defined?><?endif?>
  <?ifndef LicenseRtf?><?error LicenseRtf is not defined?><?endif?>
  <?ifndef IconFile?><?define IconFile = "$(sys.SOURCEFILEDIR)..\..\client\app\icons\player.ico"?><?endif?>

  <!-- Same ids as the Inno installer: the Player's AUMID and the old uninstall key. -->
  <?define AppUserModelId = "FrameBeam.Player"?>
  <?define InnoKey = "Software\Microsoft\Windows\CurrentVersion\Uninstall\{6F0C2B7E-3D1A-4C55-9B8E-F4A1D2C37A60}_is1"?>

  <Package Name="FrameBeam" Manufacturer="FrameBeam" Version="$(ProductVersion)"
           UpgradeCode="3B9D7A52-6C14-4E8F-A2D5-71F0C8E94B36" Scope="perUserOrMachine"
           Language="1033" InstallerVersion="500" Compressed="yes">

    <!-- afterInstallInitialize: RemoveExistingProducts (and the deferred removal actions below) must sit between InstallInitialize and
         InstallFinalize (ICE77); the default schedule would put it before InstallInitialize. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of FrameBeam is already installed." AllowSameVersionUpgrades="yes" Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="PlayerIcon" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="PlayerIcon" />
    <WixVariable Id="WixUILicenseRtf" Value="$(LicenseRtf)" />

    <!-- ===== Public properties (Secure: they must reach the elevated server when a per-user UI elevates) ===== -->
    <Property Id="INSTALL_PLAYER" Value="1" Secure="yes" />
    <Property Id="INSTALL_HUB" Secure="yes" />
    <!-- Not given: the port of the installed Hub (upgrade), else 8443 (see SetHubPortDefault). -->
    <Property Id="HUB_PORT" Secure="yes" />
    <Property Id="HUB_PORT_DEFAULT" Value="8443">
      <RegistrySearch Id="HubPortInstalled" Root="HKLM" Key="Software\FrameBeam\Hub" Name="PortText" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="HUB_SHARING_OLD">
      <RegistrySearch Id="HubSharingInstalled" Root="HKLM" Key="Software\FrameBeam\Hub" Name="SharingFlag" Type="raw" Bitness="always64" />
    </Property>
    <!-- Unset on the command line: 1 for Hub only, 0 for Player and Hub (see SetNetworkSharingDefault). -->
    <Property Id="NETWORK_SHARING" Secure="yes" />
    <Property Id="DESKTOP_SHORTCUT" Secure="yes" />
    <Property Id="INSTALL_CHOICE" Value="PLAYER" Secure="yes" />
    <Property Id="HUB_SHARING_FLAG" Value="false" />

    <!-- ===== Scope and defaults ===== -->
    <!-- INSTALL_HUB=1 / ADDLOCAL with Hub means per machine (ALLUSERS=1, MSIINSTALLPERUSER cleared); the elevation comes
         from the caller (silent) or from the UAC prompt of a limited-privilege package (UI). -->
    <SetProperty Id="ALLUSERS" Value="1" Before="LaunchConditions" Sequence="both"
                 Condition="INSTALL_HUB=&quot;1&quot; OR ADDLOCAL ~&gt;&lt; &quot;Hub&quot;" />
    <SetProperty Id="MSIINSTALLPERUSER" Value="{}" After="SetALLUSERS" Sequence="both"
                 Condition="INSTALL_HUB=&quot;1&quot; OR ADDLOCAL ~&gt;&lt; &quot;Hub&quot;" />
    <SetProperty Id="HUB_PORT" Action="SetHubPortDefault" Value="[HUB_PORT_DEFAULT]" Before="LaunchConditions" Sequence="both"
                 Condition="HUB_PORT=&quot;&quot;" />
    <!-- Upgrades (e.g. by the Hub updater, which passes only ALLUSERS=1) keep the installed feature set (MigrateFeatureStates
         wins: the feature Levels below only apply to fresh installs), the port and the sharing choice of the installed Hub. -->
    <SetProperty Id="NETWORK_SHARING" Action="SetSharingFromInstalledOn" Value="1" Before="SetNETWORK_SHARING" Sequence="execute"
                 Condition="NETWORK_SHARING=&quot;&quot; AND HUB_SHARING_OLD=&quot;true&quot;" />
    <SetProperty Id="NETWORK_SHARING" Action="SetSharingFromInstalledOff" Value="0" Before="SetNETWORK_SHARING" Sequence="execute"
                 Condition="NETWORK_SHARING=&quot;&quot; AND HUB_SHARING_OLD=&quot;false&quot;" />
    <!-- Network sharing default when not given: Hub only = on; Player and Hub = off (unset counts as off; the Player runs on the same PC). -->
    <SetProperty Id="NETWORK_SHARING" Value="1" Before="CostInitialize" Sequence="execute"
                 Condition="NETWORK_SHARING=&quot;&quot; AND INSTALL_PLAYER=&quot;0&quot;" />
    <SetProperty Id="HUB_SHARING_FLAG" Value="true" Before="CostFinalize" Sequence="execute"
                 Condition="NETWORK_SHARING=&quot;1&quot;" />
    <!-- Per user: same folder as the Inno installer. Per machine keeps ProgramFiles64Folder\FrameBeam\Player. -->
    <SetDirectory Id="PLAYERDIR" Value="[LocalAppDataFolder]Programs\FrameBeam Player" Sequence="execute"
                  Condition="NOT ALLUSERS=1" />

    <Launch Condition="Installed OR (HUB_PORT &gt;= 1 AND HUB_PORT &lt;= 65535)"
            Message="HUB_PORT must be a TCP port number between 1 and 65535." />
    <Launch Condition="Installed OR INSTALL_HUB&lt;&gt;&quot;1&quot; OR ALLUSERS=1"
            Message="The FrameBeam Hub can only be installed for all users. Run the installer as administrator." />

    <!-- ===== Detection of earlier installs ===== -->
    <Property Id="INNO_UNINSTALL_USER">
      <RegistrySearch Id="InnoUserKey" Root="HKCU" Key="$(InnoKey)" Name="UninstallString" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="INNO_UNINSTALL_MACHINE">
      <RegistrySearch Id="InnoMachineKey" Root="HKLM" Key="$(InnoKey)" Name="UninstallString" Type="raw" Bitness="always64" />
    </Property>
    <!-- A per-user MSI install of this product (written by PlayerUserRegistry below). -->
    <Property Id="PERUSER_PRODUCTCODE">
      <RegistrySearch Id="PerUserProductCode" Root="HKCU" Key="Software\FrameBeam\Player" Name="ProductCode" Type="raw" Bitness="always64" />
    </Property>

    <!-- Inno: silent uninstall (keeps data\). The user's own install runs impersonated; an all-users one needs the
         elevated, per-machine package. Deferred, so scheduled inside the script (after InstallInitialize, before InstallFiles; ICE77). -->
    <CustomAction Id="RemoveInnoUser" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="RemoveInnoMachine" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="check" />
    <SetProperty Id="RemoveInnoUser" Value="[INNO_UNINSTALL_USER] /VERYSILENT /SUPPRESSMSGBOXES /NORESTART" Before="RemoveInnoUser" Sequence="execute"
                 Condition="NOT Installed AND INNO_UNINSTALL_USER" />
    <SetProperty Id="RemoveInnoMachine" Value="[INNO_UNINSTALL_MACHINE] /VERYSILENT /SUPPRESSMSGBOXES /NORESTART" Before="RemoveInnoMachine" Sequence="execute"
                 Condition="NOT Installed AND ALLUSERS=1 AND INNO_UNINSTALL_MACHINE" />

    <!-- Per-user MSI product (installing per machine): `msiexec /x <code> /qn`, impersonated. A nested msiexec started
         while this installation holds the _MSIExecute mutex fails with 1618, so the removal is a detached process
         that waits until this installation has finished (asyncNoWait, no result checked). -->
    <CustomAction Id="RemovePerUserProduct" Directory="TempFolder" Execute="deferred" Impersonate="yes" Return="asyncNoWait"
                  ExeCommand="&quot;[System64Folder]cmd.exe&quot; /c ping -n 15 127.0.0.1 &gt;nul &amp; &quot;[System64Folder]msiexec.exe&quot; /x [PERUSER_PRODUCTCODE] /qn /norestart" />

    <InstallExecuteSequence>
      <Custom Action="RemoveInnoUser" After="InstallInitialize" Condition="NOT Installed AND INNO_UNINSTALL_USER" />
      <Custom Action="RemoveInnoMachine" After="InstallInitialize" Condition="NOT Installed AND ALLUSERS=1 AND INNO_UNINSTALL_MACHINE" />
      <!-- Only per machine, and never for our own product code (an upgrade of the per-user install by itself). -->
      <Custom Action="RemovePerUserProduct" Before="InstallFiles"
              Condition="NOT Installed AND ALLUSERS=1 AND PERUSER_PRODUCTCODE AND PERUSER_PRODUCTCODE&lt;&gt;ProductCode" />
    </InstallExecuteSequence>

    <!-- A running Player is asked to close (WM_CLOSE) before files are replaced; the launcher and the real Player have the
         same image name. If it stays open, Windows Installer's file-in-use handling takes over (dialog in the UI). -->
    <util:CloseApplication Id="ClosePlayer" Target="framebeam_player.exe" CloseMessage="yes" RebootPrompt="no" />
    <util:CloseApplication Id="ClosePlayerDash" Target="framebeam-player.exe" CloseMessage="yes" RebootPrompt="no" />

    <!-- ===== Features ===== -->
    <Feature Id="Player" Title="FrameBeam Player" Level="1" AllowAdvertise="no">
      <Level Value="0" Condition="INSTALL_PLAYER=&quot;0&quot;" />
      <ComponentGroupRef Id="PlayerFiles" />
      <ComponentRef Id="PlayerMarker" />
      <ComponentRef Id="PlayerShell" />
      <ComponentRef Id="PlayerUserRegistry" />
      <ComponentRef Id="PlayerDesktopShortcut" />
    </Feature>
    <Feature Id="Hub" Title="FrameBeam Hub" Level="2" AllowAdvertise="no">
      <Level Value="1" Condition="INSTALL_HUB=&quot;1&quot;" />
      <ComponentRef Id="HubProgram" />
      <ComponentRef Id="HubMarker" />
      <ComponentRef Id="HubRegistry" />
      <ComponentRef Id="HubDataFolders" />
    </Feature>

    <!-- ===== UI: welcome, licence, what to install, Hub options, ready, progress, finish ===== -->
    <UIRef Id="FrameBeamUI" />
  </Package>

  <!-- ===== Directories ===== -->
  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="FRAMEBEAMDIR" Name="FrameBeam">
        <Directory Id="PLAYERDIR" Name="Player" />
        <Directory Id="HUBDIR" Name="Hub" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="PDFRAMEBEAM" Name="FrameBeam">
        <Directory Id="PDHUB" Name="Hub">
          <Directory Id="PDHUBREQUEST" Name="update-request" />
        </Directory>
        <Directory Id="PDHUBUPDATER" Name="HubUpdater" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

  <!-- ===== Player ===== -->
  <Fragment>
    <!-- The assembled package: launcher framebeam_player.exe, THIRD-PARTY-NOTICE.txt, LICENSE.txt, licenses\ at the top,
         the real Player, Qt/vcpkg DLLs, plugins and qml in bin\. data\ is never part of the MSI (ADR 0004). -->
    <ComponentGroup Id="PlayerFiles" Directory="PLAYERDIR">
      <Files Include="$(PackageDir)\**">
        <Exclude Files="$(PackageDir)\data\**" />
      </Files>
    </ComponentGroup>

    <!-- Start menu shortcut (with the AUMID the executables use), install marker and folder of the install. -->
    <Component Id="PlayerMarker" Directory="PLAYERDIR" Guid="*">
      <File Id="PlayerMarkerFile" Name="framebeam-player.msi-installed" Source="$(sys.SOURCEFILEDIR)msi-marker.txt" KeyPath="yes" />
    </Component>
    <Component Id="PlayerShell" Directory="PLAYERDIR" Guid="*">
      <Shortcut Id="PlayerStartMenu" Directory="ProgramMenuFolder" Name="FrameBeam Player"
                Target="[PLAYERDIR]framebeam_player.exe" WorkingDirectory="PLAYERDIR" Icon="PlayerIcon">
        <ShortcutProperty Key="System.AppUserModel.ID" Value="$(AppUserModelId)" />
      </Shortcut>
      <RegistryValue Root="HKMU" Key="Software\FrameBeam\Player" Name="InstallDir" Type="string" Value="[PLAYERDIR]" KeyPath="yes" />
    </Component>

    <!-- Per-user installs record their product code: a later per-machine install removes this product (see above). -->
    <Component Id="PlayerUserRegistry" Directory="PLAYERDIR" Guid="*" Condition="NOT ALLUSERS=1">
      <RegistryValue Root="HKCU" Key="Software\FrameBeam\Player" Name="ProductCode" Type="string" Value="[ProductCode]" KeyPath="yes" />
    </Component>

    <Component Id="PlayerDesktopShortcut" Directory="DesktopFolder" Guid="*" Condition="DESKTOP_SHORTCUT=&quot;1&quot;">
      <Shortcut Id="PlayerDesktop" Name="FrameBeam Player" Target="[PLAYERDIR]framebeam_player.exe"
                WorkingDirectory="PLAYERDIR" Icon="PlayerIcon">
        <ShortcutProperty Key="System.AppUserModel.ID" Value="$(AppUserModelId)" />
      </Shortcut>
      <RegistryValue Root="HKMU" Key="Software\FrameBeam\Player" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- ===== Hub (per machine only) ===== -->
  <Fragment>
    <Component Id="HubProgram" Directory="HUBDIR" Guid="*">
      <File Id="HubExe" Name="framebeam-hub.exe" Source="$(HubExe)" KeyPath="yes" />

      <!-- Virtual service account NT SERVICE\FrameBeamHub; its folder rights are granted in GrantHubFolders. -->
      <ServiceInstall Id="HubService" Name="FrameBeamHub" DisplayName="FrameBeam Hub"
                      Description="FrameBeam Hub: central ROM library, saves and sessions."
                      Type="ownProcess" Start="auto" ErrorControl="normal" Vital="yes"
                      Account="NT SERVICE\FrameBeamHub"
                      Arguments="-listen :[HUB_PORT] -network-sharing=[HUB_SHARING_FLAG]">
        <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart" ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="5" ResetPeriodInDays="1" />
      </ServiceInstall>
      <ServiceControl Id="HubServiceControl" Name="FrameBeamHub" Start="install" Stop="both" Remove="uninstall" Wait="yes" />

      <ServiceInstall Id="HubUpdaterService" Name="FrameBeamHubUpdater" DisplayName="FrameBeam Hub Updater"
                      Description="Applies FrameBeam Hub updates requested from the Hub web UI."
                      Type="ownProcess" Start="auto" ErrorControl="normal" Vital="yes"
                      Arguments="update watch">
        <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart" ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="5" ResetPeriodInDays="1" />
      </ServiceInstall>
      <ServiceControl Id="HubUpdaterServiceControl" Name="FrameBeamHubUpdater" Start="install" Stop="both" Remove="uninstall" Wait="yes" />

      <!-- Program based, so the Hub port and the TURN relay ports (-turn-port/-turn-relay-ports) are covered. The Hub binds
           only loopback while network sharing is off, which the rules do not change. -->
      <fw:FirewallException Id="HubFirewallTcp" Name="FrameBeam Hub (TCP)" File="HubExe" Protocol="tcp" Scope="any" Profile="all" IgnoreFailure="yes" />
      <fw:FirewallException Id="HubFirewallUdp" Name="FrameBeam Hub (UDP, TURN)" File="HubExe" Protocol="udp" Scope="any" Profile="all" IgnoreFailure="yes" />
    </Component>

    <Component Id="HubMarker" Directory="HUBDIR" Guid="*">
      <File Id="HubMarkerFile" Name="framebeam-hub.msi-installed" Source="$(sys.SOURCEFILEDIR)msi-marker.txt" KeyPath="yes" />
    </Component>

    <!-- The Player finds the local Hub here. -->
    <Component Id="HubRegistry" Directory="HUBDIR" Guid="*">
      <RegistryValue Root="HKLM" Key="Software\FrameBeam\Hub" Name="Port" Type="integer" Value="[HUB_PORT]" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="Software\FrameBeam\Hub" Name="InstallDir" Type="string" Value="[HUBDIR]" />
      <!-- Text copies for the next upgrade's RegistrySearch (a DWORD would come back as "#18443"). -->
      <RegistryValue Root="HKLM" Key="Software\FrameBeam\Hub" Name="PortText" Type="string" Value="[HUB_PORT]" />
      <RegistryValue Root="HKLM" Key="Software\FrameBeam\Hub" Name="SharingFlag" Type="string" Value="[HUB_SHARING_FLAG]" />
    </Component>

    <!-- Data folders are created empty and left behind on uninstall when they hold data. -->
    <Component Id="HubDataFolders" Directory="PDHUB" Guid="*">
      <CreateFolder />
      <CreateFolder Directory="PDHUBREQUEST" />
      <CreateFolder Directory="PDHUBUPDATER" />
      <RegistryValue Root="HKLM" Key="Software\FrameBeam\Hub" Name="DataFolders" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- ACLs (icacls: the service SID NT SERVICE\FrameBeamHub only resolves once InstallServices has created the service,
         which is why PermissionEx is not used). After InstallServices, before StartServices:
           Hub data: SYSTEM + Administrators full, NT SERVICE\FrameBeamHub modify (update-request\ inherits it).
           HubUpdater: SYSTEM + Administrators only. -->
    <CustomAction Id="GrantHubFolders" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="GrantHubUpdaterFolder" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="check" />
    <SetProperty Id="GrantHubFolders" Before="GrantHubFolders" Sequence="execute"
                 Value="&quot;[System64Folder]icacls.exe&quot; &quot;[CommonAppDataFolder]FrameBeam\Hub&quot; /inheritance:r /grant:r *S-1-5-18:(OI)(CI)F *S-1-5-32-544:(OI)(CI)F &quot;NT SERVICE\FrameBeamHub:(OI)(CI)M&quot;"
                 Condition="&amp;Hub=3" />
    <SetProperty Id="GrantHubUpdaterFolder" Before="GrantHubUpdaterFolder" Sequence="execute"
                 Value="&quot;[System64Folder]icacls.exe&quot; &quot;[CommonAppDataFolder]FrameBeam\HubUpdater&quot; /inheritance:r /grant:r *S-1-5-18:(OI)(CI)F *S-1-5-32-544:(OI)(CI)F"
                 Condition="&amp;Hub=3" />
    <InstallExecuteSequence>
      <Custom Action="GrantHubFolders" After="InstallServices" Condition="&amp;Hub=3" />
      <Custom Action="GrantHubUpdaterFolder" After="GrantHubFolders" Condition="&amp;Hub=3" />
    </InstallExecuteSequence>
  </Fragment>

  <!-- ===== UI ===== -->
  <Fragment>
    <UI Id="FrameBeamUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="WixUI_Mode" Value="Mondo" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />
      <DialogRef Id="LicenseAgreementDlg" />
      <DialogRef Id="VerifyReadyDlg" />
      <DialogRef Id="MaintenanceWelcomeDlg" />
      <DialogRef Id="MaintenanceTypeDlg" />
      <DialogRef Id="ExitDialog" />
      <DialogRef Id="CancelDlg" />
      <UIRef Id="WixUI_Common" />

      <!-- What to install. Player only = per user without administrator rights; with Hub = per machine (UAC prompt). -->
      <Dialog Id="ChoiceDlg" Width="370" Height="270" Title="!(loc.WelcomeDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}What do you want to install?" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="Choose the parts of FrameBeam for this PC." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Choice" Type="RadioButtonGroup" X="20" Y="55" Width="330" Height="110" Property="INSTALL_CHOICE">
          <RadioButtonGroup Property="INSTALL_CHOICE">
            <RadioButton Value="PLAYER" X="0" Y="0" Width="330" Height="18" Text="FrameBeam &amp;Player (play games, for your account only)" />
            <RadioButton Value="HUB" X="0" Y="36" Width="330" Height="18" Text="FrameBeam &amp;Hub (ROM library and saves for your network, as a service)" />
            <RadioButton Value="BOTH" X="0" Y="72" Width="330" Height="18" Text="Player a&amp;nd Hub (everything on this PC)" />
          </RadioButtonGroup>
        </Control>
        <Control Id="Admin" Type="Text" X="20" Y="150" Width="330" Height="26" Transparent="yes" NoPrefix="yes"
                 Text="The Hub runs as a Windows service for all users and needs administrator rights; Windows asks for them when you continue." />
        <Control Id="DesktopShortcut" Type="CheckBox" X="20" Y="190" Width="330" Height="18" Property="DESKTOP_SHORTCUT" CheckBoxValue="1" Text="Create a &amp;desktop shortcut for the Player" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="LicenseAgreementDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Property="INSTALL_PLAYER" Value="0" Condition="INSTALL_CHOICE=&quot;HUB&quot;" Order="1" />
          <Publish Property="INSTALL_PLAYER" Value="1" Condition="INSTALL_CHOICE&lt;&gt;&quot;HUB&quot;" Order="2" />
          <Publish Property="INSTALL_HUB" Value="1" Condition="INSTALL_CHOICE&lt;&gt;&quot;PLAYER&quot;" Order="3" />
          <Publish Property="INSTALL_HUB" Value="{}" Condition="INSTALL_CHOICE=&quot;PLAYER&quot;" Order="4" />
          <Publish Property="NETWORK_SHARING" Value="1" Condition="INSTALL_CHOICE=&quot;HUB&quot;" Order="5" />
          <Publish Property="NETWORK_SHARING" Value="0" Condition="INSTALL_CHOICE&lt;&gt;&quot;HUB&quot;" Order="6" />
          <Publish Property="ALLUSERS" Value="1" Condition="INSTALL_CHOICE&lt;&gt;&quot;PLAYER&quot;" Order="7" />
          <Publish Property="MSIINSTALLPERUSER" Value="{}" Condition="INSTALL_CHOICE&lt;&gt;&quot;PLAYER&quot;" Order="8" />
          <Publish Property="ALLUSERS" Value="2" Condition="INSTALL_CHOICE=&quot;PLAYER&quot;" Order="9" />
          <Publish Property="MSIINSTALLPERUSER" Value="1" Condition="INSTALL_CHOICE=&quot;PLAYER&quot;" Order="10" />
          <Publish Event="NewDialog" Value="HubOptionsDlg" Condition="INSTALL_CHOICE&lt;&gt;&quot;PLAYER&quot;" Order="20" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Condition="INSTALL_CHOICE=&quot;PLAYER&quot;" Order="21" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- Hub options: port and network sharing. -->
      <Dialog Id="HubOptionsDlg" Width="370" Height="270" Title="!(loc.WelcomeDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Hub options" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="The Hub is installed as the Windows service FrameBeamHub." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="PortLabel" Type="Text" X="20" Y="62" Width="150" Height="16" Transparent="yes" NoPrefix="yes" Text="HTTPS &amp;port of the Hub:" />
        <Control Id="Port" Type="Edit" X="175" Y="59" Width="60" Height="18" Property="HUB_PORT" Sunken="yes" Text="{5}" />
        <Control Id="Sharing" Type="CheckBox" X="20" Y="95" Width="330" Height="18" Property="NETWORK_SHARING" CheckBoxValue="1" Text="&amp;Allow other devices on the network to connect" />
        <Control Id="SharingHelp" Type="Text" X="38" Y="115" Width="312" Height="40" Transparent="yes" NoPrefix="yes"
                 Text="Off: only this PC can reach the Hub. On: other Players on your network can connect and the Windows firewall rules apply. You can change this later in the Hub settings." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="ChoiceDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <!-- An unchecked box leaves the property empty, which the silent default would read as "not given". -->
          <Publish Property="NETWORK_SHARING" Value="0" Condition="NETWORK_SHARING=&quot;&quot;" Order="1" />
          <Publish Event="SpawnDialog" Value="InvalidPortDlg" Condition="NOT (HUB_PORT &gt;= 1 AND HUB_PORT &lt;= 65535)" Order="2" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Condition="HUB_PORT &gt;= 1 AND HUB_PORT &lt;= 65535" Order="3" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <Dialog Id="InvalidPortDlg" Width="260" Height="85" Title="[ProductName]">
        <Control Id="Text" Type="Text" X="48" Y="15" Width="194" Height="30" Text="The port must be a number between 1 and 65535." />
        <Control Id="Icon" Type="Icon" X="15" Y="15" Width="24" Height="24" ToolTip="Information" FixedSize="yes" IconSize="32" Text="WixUI_Ico_Info" />
        <Control Id="OK" Type="PushButton" X="102" Y="57" Width="56" Height="17" Default="yes" Cancel="yes" Text="!(loc.WixUIOK)">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <!-- Flow -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="2" Condition="Installed AND PATCH" />
      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="1" />
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="ChoiceDlg" Order="2" Condition="LicenseAccepted = 1" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="HubOptionsDlg" Order="1" Condition="NOT Installed AND INSTALL_HUB=&quot;1&quot;" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ChoiceDlg" Order="2" Condition="NOT Installed AND INSTALL_HUB&lt;&gt;&quot;1&quot;" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="3" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" Order="2" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" Order="2" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
    </UI>
  </Fragment>
</Wix>
