#!/bin/sh
# uzume-server prerm: stop the units on removal. On upgrade the postinst of the new version restarts the service.
set -e

case "$1" in
  remove|deconfigure)
    if [ -d /run/systemd/system ]; then
      systemctl stop uzume-server-update.path uzume-server-update.service uzume-server.service || true
      systemctl disable uzume-server.service uzume-server-update.path >/dev/null 2>&1 || true
    fi
    ;;
  upgrade|failed-upgrade)
    ;;
  *)
    echo "prerm called with unknown argument '$1'" >&2
    exit 1
    ;;
esac

exit 0
