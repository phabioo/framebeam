#!/bin/sh
# uzume-server postinst: user, directories, server.env (created only when missing, never overwritten), migration of an
# install-server.sh install, units. Data (/var/lib/uzume or a custom data dir) is never touched beyond creating
# the default.
set -e

SVC_USER=uzume
ENV_DIR=/etc/uzume
ENV_FILE=$ENV_DIR/server.env
DATA_DIR=/var/lib/uzume

case "$1" in
  configure)
    getent group "$SVC_USER" >/dev/null 2>&1 || groupadd --system "$SVC_USER"
    id -u "$SVC_USER" >/dev/null 2>&1 || useradd --system --gid "$SVC_USER" --no-create-home \
      --home-dir /nonexistent --shell /usr/sbin/nologin "$SVC_USER"

    install -d -m 0750 -o root -g "$SVC_USER" "$ENV_DIR"
    if [ ! -f "$ENV_FILE" ]; then
      ( umask 027
        {
          echo "# Uzume server configuration (read by systemd, see uzume-server.service)."
          echo "# UZUME_NAME is only used on the first start."
          echo "UZUME_LISTEN=:8443"
          echo "UZUME_DATA_DIR=$DATA_DIR"
          echo "# Sessions over the internet (relay server, see the README): uncomment and set your DNS name."
          echo "#UZUME_TURN=1"
          echo "#UZUME_PUBLIC_HOST=hub.example.org"
        } >"$ENV_FILE" )
      chown "root:$SVC_USER" "$ENV_FILE"
      chmod 0640 "$ENV_FILE"
    fi
    # The default data dir is created if missing; existing content is left alone.
    if [ ! -d "$DATA_DIR" ]; then
      install -d -m 0750 -o "$SVC_USER" -g "$SVC_USER" "$DATA_DIR"
    fi

    # Migration from install-server.sh: its unit in /etc/systemd/system would shadow the packaged one. Keep it
    # for reference; drop-ins in uzume-server.service.d/ stay and keep applying.
    OLD_UNIT=/etc/systemd/system/uzume-server.service
    if [ -f "$OLD_UNIT" ] && grep -qE '/usr/local/bin/uzume-server' "$OLD_UNIT"; then
      mv -f "$OLD_UNIT" "$ENV_DIR/uzume-server.service.pre-deb"
      rm -f /usr/local/bin/uzume-server
      echo "uzume-server: migrated a script install (old unit kept as $ENV_DIR/uzume-server.service.pre-deb)"
    fi

    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload || true
      systemctl enable uzume-server.service uzume-server-update.path >/dev/null 2>&1 || true
      if systemctl is-active --quiet uzume-server.service; then
        systemctl restart uzume-server.service || true
      else
        systemctl start uzume-server.service || true
      fi
      systemctl start uzume-server-update.path || true
    fi
    ;;
  abort-upgrade|abort-remove|abort-deconfigure)
    ;;
  *)
    echo "postinst called with unknown argument '$1'" >&2
    exit 1
    ;;
esac

exit 0
