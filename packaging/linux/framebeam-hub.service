[Unit]
Description=FrameBeam Hub
Documentation=https://github.com/phabioo/framebeam
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=framebeam
Group=framebeam
EnvironmentFile=/etc/framebeam/hub.env
ExecStart=/usr/local/bin/framebeam-hub
Restart=on-failure
RestartSec=5

# Hardening. The install script writes a drop-in
# (framebeam-hub.service.d/data-dir.conf) when the data dir is not
# /var/lib/framebeam or the port is below 1024.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/framebeam
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
