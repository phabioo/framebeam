[Unit]
Description=Uzume server
Documentation=https://github.com/phabioo/uzume
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uzume
Group=uzume
EnvironmentFile=/etc/uzume/server.env
ExecStart=/usr/local/bin/uzume-server
Restart=on-failure
RestartSec=5

# Hardening. The install script writes a drop-in
# (uzume-server.service.d/data-dir.conf) when the data dir is not
# /var/lib/uzume or the port is below 1024.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/uzume
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
