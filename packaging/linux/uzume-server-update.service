[Unit]
Description=Apply a staged Uzume server update
Documentation=https://github.com/phabioo/uzume

[Service]
Type=oneshot
# Runs as root: verifies the staged package again (signature, size, SHA-256) and installs it with dpkg.
EnvironmentFile=-/etc/uzume/server.env
ExecStart=/usr/bin/uzume-server update apply-staged
