{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framebeam.invalid/schemas/ws-viewer-left.schema.json",
  "title": "ws-viewer-left (Hub to owner device and viewer device)",
  "type": "object",
  "required": [
    "type",
    "payload"
  ],
  "properties": {
    "type": {
      "const": "viewer_left"
    },
    "id": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "required": [
        "session_id",
        "viewer_id",
        "reason"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "viewer_id": {
          "type": "string",
          "format": "uuid"
        },
        "reason": {
          "enum": [
            "left",
            "removed",
            "revoked",
            "disconnected"
          ]
        }
      }
    }
  }
}
