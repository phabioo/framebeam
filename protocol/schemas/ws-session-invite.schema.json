{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framebeam.invalid/schemas/ws-session-invite.schema.json",
  "title": "ws-session-invite (Hub to Player: the user has been invited)",
  "type": "object",
  "required": [
    "type",
    "payload"
  ],
  "properties": {
    "type": {
      "const": "session_invite"
    },
    "id": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "required": [
        "session"
      ],
      "properties": {
        "session": {
          "$ref": "ws-session.schema.json"
        }
      }
    }
  }
}
