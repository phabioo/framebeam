{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framebeam.invalid/schemas/ws-viewer-joined.schema.json",
  "title": "ws-viewer-joined (Hub to owner device)",
  "type": "object",
  "required": [
    "type",
    "payload"
  ],
  "properties": {
    "type": {
      "const": "viewer_joined"
    },
    "id": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "required": [
        "session_id",
        "viewer_id",
        "display_name",
        "device_name"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "viewer_id": {
          "type": "string",
          "format": "uuid"
        },
        "display_name": {
          "type": "string"
        },
        "device_name": {
          "type": "string"
        }
      }
    }
  }
}
