{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framebeam.invalid/schemas/ws-viewer-joined.schema.json",
  "title": "ws-viewer-joined (Hub to owner device)",
  "type": "object",
  "required": [
    "type",
    "payload"
  ],
  "properties": {
    "type": {
      "const": "viewer_joined"
    },
    "id": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "required": [
        "session_id",
        "viewer_id",
        "display_name",
        "device_name"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "viewer_id": {
          "type": "string",
          "format": "uuid"
        },
        "display_name": {
          "type": "string"
        },
        "device_name": {
          "type": "string"
        },
        "turn_servers": {
          "type": "array",
          "description": "Optional fresh relay credentials for the owner device; present only while the Hub's TURN server is on (feature turn_v1)",
          "items": {
            "type": "object",
            "required": [
              "urls",
              "username",
              "credential",
              "expires_at"
            ],
            "properties": {
              "urls": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^turns?:"
                }
              },
              "username": {
                "type": "string"
              },
              "credential": {
                "type": "string"
              },
              "expires_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  }
}
