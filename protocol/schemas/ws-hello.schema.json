{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framebeam.invalid/schemas/ws-hello.schema.json",
  "title": "ws-hello (Player an Hub)",
  "type": "object",
  "required": ["type", "payload"],
  "properties": {
    "type": { "const": "hello" },
    "id": { "type": "string" },
    "payload": {
      "type": "object",
      "required": ["protocol_version"],
      "properties": { "protocol_version": { "type": "integer", "minimum": 1 } }
    }
  }
}
