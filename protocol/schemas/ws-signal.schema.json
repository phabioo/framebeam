{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framebeam.invalid/schemas/ws-signal.schema.json",
  "title": "ws-signal (both directions, relayed unchanged between owner device and viewer device)",
  "type": "object",
  "required": [
    "type",
    "payload"
  ],
  "properties": {
    "type": {
      "const": "signal"
    },
    "id": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "required": [
        "session_id",
        "viewer_id",
        "kind"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "viewer_id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "enum": [
            "offer",
            "answer",
            "candidate"
          ]
        },
        "sdp": {
          "type": "string"
        },
        "candidate": {
          "type": "string"
        },
        "mid": {
          "type": "string"
        }
      }
    }
  }
}
