{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framebeam.invalid/schemas/ws-hello-ack.schema.json",
  "title": "ws-hello-ack (Hub to Player)",
  "type": "object",
  "required": [
    "type",
    "payload"
  ],
  "properties": {
    "type": {
      "const": "hello_ack"
    },
    "id": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "required": [
        "protocol_version",
        "hub_version",
        "features",
        "ice_servers"
      ],
      "properties": {
        "protocol_version": {
          "type": "integer",
          "minimum": 1
        },
        "hub_version": {
          "type": "string"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ice_servers": {
          "type": "array",
          "description": "stun: URLs (Hub config, default empty)",
          "items": {
            "type": "string",
            "pattern": "^stuns?:"
          }
        }
      }
    }
  }
}
