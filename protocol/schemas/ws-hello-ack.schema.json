{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uzume.invalid/schemas/ws-hello-ack.schema.json",
  "title": "ws-hello-ack (server to app)",
  "type": "object",
  "required": [
    "type",
    "payload"
  ],
  "properties": {
    "type": {
      "const": "hello_ack"
    },
    "id": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "required": [
        "protocol_version",
        "hub_version",
        "features",
        "ice_servers"
      ],
      "properties": {
        "protocol_version": {
          "type": "integer",
          "minimum": 1
        },
        "hub_version": {
          "type": "string"
        },
        "features": {
          "type": "array",
          "description": "Short list of the flags relevant to the WSS connection (saves_v1, saves_v2, sessions_v1, ice_update_v1, runs_v1, local_roms_v1, plus turn_v1 exactly when turn_servers is present). Not the full feature set: the authoritative list is `features` of the POST /handshake response, an app must not treat a flag missing here as unsupported",
          "items": {
            "type": "string"
          }
        },
        "ice_servers": {
          "type": "array",
          "description": "stun: URLs: the server's configured list (default stun:stun.cloudflare.com:3478, empty with -ice-servers none) plus the server's own STUN when the embedded TURN server is on",
          "items": {
            "type": "string",
            "pattern": "^stuns?:"
          }
        },
        "turn_servers": {
          "type": "array",
          "description": "Optional relay credentials from every active relay provider (the embedded TURN server and/or Cloudflare TURN); present only while a provider is on (feature turn_v1)",
          "items": {
            "type": "object",
            "required": [
              "urls",
              "username",
              "credential"
            ],
            "properties": {
              "urls": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^turns?:"
                }
              },
              "username": {
                "type": "string"
              },
              "credential": {
                "type": "string"
              },
              "expires_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  }
}
