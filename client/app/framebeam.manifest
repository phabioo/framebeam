<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Application manifest of framebeam_player.exe and the launcher framebeam_player.exe (shared).
     No trustInfo here: the MSVC linker's generated manifest already requests asInvoker and CMake merges this file into it.
     - longPathAware: the Win32 file APIs (also the narrow ones the libretro cores use) accept paths beyond MAX_PATH,
       provided LongPathsEnabled is set; without it the short save directories (SaveStore::shortCoreDir) stay the protection.
     - activeCodePage UTF-8 (Windows 10 1903+): the narrow (A) APIs and fromLocal8Bit/qgetenv see the UTF-8 paths we hand to cores. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
